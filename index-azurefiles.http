### 28. all - Verify content and groups (no user token = no results)
POST {{$dotenv SEARCH_ENDPOINT}}/indexes/af-index-all/docs/search?api-version=2026-08-01-preview
Authorization: Bearer {{$dotenv SEARCH_TOKEN}}
Content-Type: application/json

{
  "search": "*",
  "select": "title,share,group_ids",
  "facets": [
    "share"
  ],
  "count": true,
  "top": 5
}

### 29. all - Unified knowledge source
PUT {{$dotenv SEARCH_ENDPOINT}}/knowledgesources/af-ks-all?api-version=2026-08-01-preview
Authorization: Bearer {{$dotenv SEARCH_TOKEN}}
Content-Type: application/json

{
  "name": "af-ks-all",
  "kind": "searchIndex",
  "description": "Documents from admin-share and alluser-share, filtered by the user's Entra groups.",
  "searchIndexParameters": {
    "searchIndexName": "af-index-all",
    "semanticConfigurationName": "sem",
    "searchFields": [
      {
        "name": "chunk"
      },
      {
        "name": "title"
      }
    ],
    "sourceDataFields": [
      {
        "name": "title"
      },
      {
        "name": "chunk"
      },
      {
        "name": "metadata_storage_path"
      },
      {
        "name": "share"
      }
    ]
  }
}

### 30. all - Unified knowledge base (used by the agent)
PUT {{$dotenv SEARCH_ENDPOINT}}/knowledgebases/af-kb-all?api-version=2026-08-01-preview
Authorization: Bearer {{$dotenv SEARCH_TOKEN}}
Content-Type: application/json

{
  "name": "af-kb-all",
  "description": "Unified Foundry IQ knowledge base with results filtered by the user's Entra groups.",
  "retrievalInstructions": "Retrieve relevant passages for the user's question, including when the question and documents use different languages. Do not invent facts. If no relevant evidence is available, state this clearly in English.",
  "answerInstructions": "Answer in English and cite the supplied sources. Only include facts supported by the retrieved passages.",
  "knowledgeSources": [
    {
      "name": "af-ks-all"
    }
  ],
  "models": [
    {
      "kind": "azureOpenAI",
      "azureOpenAIParameters": {
        "resourceUri": "{{$dotenv AOAI_ENDPOINT}}",
        "deploymentId": "gpt-5-mini",
        "modelName": "gpt-5-mini"
      }
    }
  ],
  "retrievalReasoningEffort": {
    "kind": "low"
  },
  "outputMode": "extractiveData"
}
